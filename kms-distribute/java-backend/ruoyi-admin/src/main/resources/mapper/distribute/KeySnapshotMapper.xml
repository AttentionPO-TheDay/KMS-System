<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.distribute.mapper.KeySnapshotMapper">

    <resultMap type="Keymanage" id="KeySnapshotResult">
        <result property="keyId" column="key_id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="encrytType" column="encryt_type"/>
        <result property="encrytName" column="encryt_name"/>
        <result property="keyName" column="key_name"/>
        <result property="chainHash" column="chain_hash"/>
        <result property="blockHeight" column="block_height"/>
    </resultMap>

    <select id="selectKeySnapshotById" parameterType="Long" resultMap="KeySnapshotResult">
        select key_id, user_id, user_name, encryt_type, encryt_name, key_name, chain_hash, block_height
        from keymanage
        where key_id = #{keyId}
    </select>

</mapper>
