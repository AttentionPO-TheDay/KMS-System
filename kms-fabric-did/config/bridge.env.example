# 默认不开启，也不允许链上写入。实际链参数必须来自链方。
FABRIC_DID_ENABLED=false
FABRIC_DID_WRITE_ENABLED=false
FABRIC_DID_CREATE_POLICY_APPROVED=false
FABRIC_DID_CHAIN_ID=
FABRIC_DID_METHOD_ID=
FABRIC_DID_NAMESPACE=kms-key-binding-v1
FABRIC_DID_HOST=127.0.0.1
FABRIC_DID_PORT=8095
# 上限是桥接侧保护，不代表链码已经支持此长度；联调后按链方限制配置。
FABRIC_DID_MAX_METADATA_BYTES=65536
INTERNAL_TOKEN=
# SDK 固定取 user.dir 父目录的 fabric.config.properties，不能指定任意位置。
# 例如进程 user.dir=/run/fabric-did/work，下面指向 /run/fabric-did/fabric.config.properties。
FABRIC_DID_PROPERTIES_FILE=
# 独立稳定管理 SM2 公钥 PEM；不是业务节点的 SM2/SSCL/KYBER/FALCON 公钥。
FABRIC_DID_CONTROLLER_PUBLIC_KEY_FILE=
# java -DfabricSDK.configuration=<只读 GMCrypto 属性文件> -jar <app.jar>
