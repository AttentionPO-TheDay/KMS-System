*.log
*.sqlite
*.db

# Build & Archives
target/
bin/
build/
dist/
out/
*.jar
*.war
*.tar
*.tar.gz
*.zip

# ⚠️ 例外：kms-ops/build/ 装的是**各服务的 Dockerfile**（构建输入，不是构建产物）。
# 上面那条通用的 `build/` 会把整个目录一起忽略 —— 实测这 6 个 Dockerfile
# 从未进入版本库，于是"下载/克隆仓库后再部署"时 `docker compose build` 必然失败：
# 找不到 Dockerfile。构建目录必须受版本管理。
!/kms-ops/build/
*.rar
*.exe
*.dll
*.so

# Go Backend specifics
# （原先这里还有 3 条 `legacy-kms-go/**` 规则，随 2026-09-26 清理删除该目录后
#   已成为死规则，一并移除。）
key-service-v1

# Node.js / Frontend specifics
node_modules/
dist-ssr/
npm-debug.log
yarn-error.log

# Temporary and Swap files
*.swp
*~
*.bak
*.tmp

# Miscellaneous
/nodes/
/kms-ops/mysql/data/
/kms-ops/kafka/kafka_data/
/kms-ops/fisco/nodes/
/kms-ops/nodes/
/kms-ops/fisco/live/
/kms-ops/fisco/console/account/
/kms-ops/fisco/console/accounts/
/kms-ops/fisco/console/log/
/kms-ops/fisco/console/deploylog.txt
/kms-ops/fisco/console/contracts/.compiled/
/kms-ops/fisco/console/contracts/sdk/abi/
/kms-ops/fisco/console/contracts/sdk/java/
/kms-ops/fisco/contracts/compiled/
/kms-ops/fisco/console/conf/*.crt
/kms-ops/fisco/console/conf/*.key
/kms-ops/fisco/console/conf/*.pem
/kms-ops/fisco/console/conf/config.toml
# 重建链时归档的 CA 私钥（ca.key / agency.key / agency/channel/ca.key）。
# 它是"以后还能签发 SDK 证书"的唯一凭据，必须留在本地，但绝不该进版本库。
/kms-ops/fisco/cert/
# build_chain.sh 的原始产物（含每节点一份 30MB 二进制副本）
/kms-ops/fisco/.rebuild/
# Java 后端侧同一套 SDK 证书（与 console/conf 同源）
/kms-ops/kms-java-backend/conf/*.crt
/kms-ops/kms-java-backend/conf/*.key
# 诊断用 Java 探针的编译产物
/kms-ops/tests/_probe_out/
/kms-ops/fisco/webase-front/log/
/kms-ops/.env
# ⚠️ 上面那条只匹配 `.env` **这一个文件名**，挡不住它的衍生文件。
# 实测漏过一个 `kms-ops/.env.bak-fisco` —— 里面是 KGC_MASTER_SECRET、
# FISCO_PRIVATE_KEY、INTERNAL_TOKEN、MYSQL_ROOT_PASSWORD 全套凭据，
# 且因为文件名以 `-fisco` 结尾，连 `*.bak` 规则也没拦住。
# 因此这里改用通配，并把模板文件显式放行。
/kms-ops/.env.*
!/kms-ops/.env.example
# 备份/归档变体：`*.bak` 只匹配以 .bak 结尾的，挡不住 `X.bak-preimage`
# 这类带后缀的写法（仓库里真实存在 docker-compose.yml.bak-preimage、
# kms-updatedel/front/src.bak-premerge 两个）。
*.bak-*
*.broken.*
*/src.bak-*/
/kms-ops/nginx/logs/
/kms-ops/runtime/
/kms-ops/front/generate/
/kms-ops/front/updatedel/
/kms-ops/front/distribute/
/kms-ops/front/user/
/kms-ops/front/acceptance/
/kms-ops/redis/data/

# Tracked FISCO template
!/kms-ops/fisco/template/
!/kms-ops/fisco/template/**

# Temp files
tmp.go
/kms-distribute/extracted/ruoyi-111-compare-*/

