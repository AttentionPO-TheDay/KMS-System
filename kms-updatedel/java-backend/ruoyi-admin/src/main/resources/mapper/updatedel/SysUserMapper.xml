<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.updatedel.mapper.SysUserMapper">

    <resultMap id="sysUserResult" type="com.ruoyi.updatedel.domain.SysUser">
        <id property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="password" column="password"/>
        <result property="roleLevel" column="role_level"/>
    </resultMap>

    <select id="selectUserById" parameterType="Long" resultMap="sysUserResult">
        select user_id, user_name, password, role_level
        from sys_user
        where user_id = #{userId}
          and del_flag = '0'
    </select>

    <select id="selectUserByUserName" parameterType="String" resultMap="sysUserResult">
        select user_id, user_name, password, role_level
        from sys_user
        where user_name = #{userName}
          and del_flag = '0'
        limit 1
    </select>

    <update id="updateRoleLevel">
        update sys_user
        set role_level = #{roleLevel},
            update_time = now()
        where user_id = #{userId}
    </update>
</mapper>
