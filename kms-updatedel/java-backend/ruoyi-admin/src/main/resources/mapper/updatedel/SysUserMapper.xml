<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.updatedel.mapper.SysUserMapper">

    <resultMap id="sysUserResult" type="com.ruoyi.updatedel.domain.SysUser">
        <id property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="password" column="password"/>
        <result property="roleLevel" column="role_level"/>
    </resultMap>

    <select id="selectUserById" parameterType="Long" resultMap="sysUserResult">
        select user_id, user_name, password, role_level
        from sys_user
        where user_id = #{userId}
          and del_flag = '0'
    </select>

    <select id="selectUserByUserName" parameterType="String" resultMap="sysUserResult">
        select user_id, user_name, password, role_level
        from sys_user
        where user_name = #{userName}
          and del_flag = '0'
        limit 1
    </select>

    <!--
      用户选择器用（P3 步骤 10）。刻意**不查 password** ——
      这个列表只是给管理员挑人用的，把口令哈希带出来没有任何必要，
      只会平白扩大泄露面。
    -->
    <select id="selectUserList" resultMap="sysUserResult">
        select user_id, user_name, role_level
        from sys_user
        where del_flag = '0'
        <if test="keyword != null and keyword != ''">
            and user_name like concat('%', #{keyword}, '%')
        </if>
        order by user_id
        limit 500
    </select>

    <!--
      原 updateRoleLevel 语句已删除。
      它曾被临时权限审批流用来改写申请人的 role_level（审批通过 → 0，回退 → 2 或已废弃的 1），
      而 role_level 现在是登录分流的唯一判据（D9/D13）。见 SysUserMapper.java 的注释。
    -->
</mapper>
