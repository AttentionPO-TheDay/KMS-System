<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.updatedel.mapper.SysUserMapper">

    <resultMap id="sysUserResult" type="SysUser">
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="password" column="password"/>
        <result property="roleLevel" column="role_level"/>
    </resultMap>

    <select id="selectUserById" parameterType="Long" resultMap="sysUserResult">
        select user_id, user_name, password, role_level from sys_user where user_id = #{userId}
    </select>

    <select id="selectUserByUserName" parameterType="String" resultMap="sysUserResult">
        select user_id, user_name, password, role_level from sys_user where user_name = #{userName}
    </select>

    <update id="updateRoleLevel">
        update sys_user set role_level = #{roleLevel} where user_id = #{userId}
    </update>
</mapper>
