<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.generate.mapper.GenerateUserMapper">

    <resultMap id="generateUserResult" type="com.ruoyi.generate.domain.GenerateUser">
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="nickName" column="nick_name"/>
        <result property="password" column="password"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="roleLevel" column="role_level"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="baseUserColumns">
        select user_id, user_name, nick_name, password, status, del_flag, role_level, create_time
        from sys_user
    </sql>

    <select id="selectByUserName" parameterType="String" resultMap="generateUserResult">
        <include refid="baseUserColumns"/>
        where user_name = #{userName}
          and del_flag = '0'
        limit 1
    </select>

    <select id="selectByUserId" parameterType="Long" resultMap="generateUserResult">
        <include refid="baseUserColumns"/>
        where user_id = #{userId}
          and del_flag = '0'
        limit 1
    </select>

    <select id="selectActiveUsers" resultMap="generateUserResult">
        <include refid="baseUserColumns"/>
        where del_flag = '0'
        order by user_id asc
    </select>

    <select id="selectNonAdminUsers" resultMap="generateUserResult">
        <include refid="baseUserColumns"/>
        where del_flag = '0'
          and role_level &gt; 0
        order by user_id asc
    </select>

    <select id="countActiveUsers" resultType="int">
        select count(1)
        from sys_user
        where del_flag = '0'
    </select>

    <insert id="insertUser" parameterType="com.ruoyi.generate.domain.GenerateUser" useGeneratedKeys="true" keyProperty="userId">
        insert into sys_user (
            user_name, nick_name, password, status, del_flag, role_level, create_by, create_time
        ) values (
            #{userName}, #{nickName}, #{password}, #{status}, #{delFlag}, #{roleLevel}, 'kms-generate', now()
        )
    </insert>
</mapper>
