# Only nginx supplies ingress credentials; browser context remains authoritative.
proxy_set_header Host $http_host;
proxy_set_header Origin $http_origin;
proxy_set_header Cookie $http_cookie;
proxy_set_header Authorization "";
proxy_set_header X-Internal-Token "";
proxy_set_header X-Kms-Service-Token "";
proxy_set_header X-Kms-Service-Id "";
proxy_set_header X-Kms-User "";
proxy_set_header X-Kms-User-Id "";
proxy_set_header X-Kms-Role "";
proxy_set_header X-Kms-Node-Id "";
proxy_set_header X-Kms-Entry-Mode demo;
proxy_set_header X-Kms-Demo-Gateway "${INTERNAL_TOKEN}";
proxy_set_header X-Kms-Demo-Session "";
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_read_timeout 180s;
