# Demo has one canonical browser origin. Other published listeners only redirect
# to it so IndexedDB-backed private material cannot split by port or scheme.
server {
    listen 80 default_server;
    listen 8088 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/tls/localhost.crt;
    ssl_certificate_key /etc/nginx/tls/localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 404;
}
server {
    listen 8088;
    server_name 127.0.0.1;
    include /etc/nginx/snippets/kms-security-headers.conf;
    client_max_body_size 20m;
    include /etc/nginx/snippets/kms-demo-locations.conf;
}
server {
    listen 8088;
    server_name localhost;
    return 308 http://127.0.0.1:8088$request_uri;
}
server {
    listen 80;
    server_name 127.0.0.1 localhost;
    return 308 http://127.0.0.1:8088$request_uri;
}
server {
    listen 443 ssl;
    server_name 127.0.0.1 localhost;
    ssl_certificate /etc/nginx/tls/localhost.crt;
    ssl_certificate_key /etc/nginx/tls/localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 308 http://127.0.0.1:8088$request_uri;
}
