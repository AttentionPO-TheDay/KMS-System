# 仅由显式 local-demo 配置发布到 127.0.0.1:8088。
server {
    listen 8088 default_server;
    server_name _;
    return 404;
}
server {
    listen 8088;
    server_name 127.0.0.1 localhost;
    include /etc/nginx/snippets/kms-security-headers.conf;
    client_max_body_size 20m;
    location = / { return 302 /updatedel/demo; }
    location = /demo { return 302 /updatedel/demo$is_args$args; }
    location /demo/ { return 302 /updatedel$request_uri; }
    # Cookie 不按端口隔离，而 IndexedDB 按 origin（含端口）隔离。
    # 返回原模式必须整页回到原 80 入口，不能在 8088 加载旧 API/空的旧密钥库。
    location = /updatedel/standalone { return 302 http://$host$request_uri; }
    location /updatedel/standalone/ { return 302 http://$host$request_uri; }
    location = /updatedel/login { return 302 http://$host$request_uri; }
    location ~* ^/updatedel/assets/ {
        root /usr/share/nginx/html;
        include /etc/nginx/snippets/kms-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location /updatedel/ {
        alias /usr/share/nginx/html/updatedel/;
        include /etc/nginx/snippets/kms-security-headers.conf;
        include /etc/nginx/snippets/kms-spa-no-store.conf;
        try_files $uri $uri/ /updatedel/index.html;
    }
    location /demo-api/lifecycle/internal/ { return 404; }
    location /demo-api/generate/internal/ { return 404; }
    location /demo-api/lifecycle/ {
        proxy_pass http://updatedel_java_backend/;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_set_header X-Internal-Token "";
        proxy_set_header X-Kms-Entry-Mode demo;
        proxy_set_header X-Kms-Demo-Gateway "${INTERNAL_TOKEN}";
        proxy_set_header X-Kms-Demo-Session "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 180s;
    }
    location /demo-api/generate/ {
        proxy_pass http://generate_java_backend/;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_set_header X-Internal-Token "";
        proxy_set_header X-Kms-Entry-Mode demo;
        proxy_set_header X-Kms-Demo-Gateway "${INTERNAL_TOKEN}";
        proxy_set_header X-Kms-Demo-Session "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 180s;
    }
    location /demo-api/pqkds/ {
        proxy_pass http://pqkds_demo_backend/api/pqkds/;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_set_header X-Internal-Token "";
        proxy_set_header X-Kms-Entry-Mode demo;
        proxy_set_header X-Kms-Demo-Gateway "${INTERNAL_TOKEN}";
        proxy_set_header X-Kms-Demo-Session "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 180s;
    }
    location / { return 404; }
}
