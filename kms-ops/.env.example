# KMS-OPS 环境变量模板
# 首次启动前可复制为 .env；若 .env 不存在，start.sh 会自动基于此模板生成
#
# ============================================================================
# 安全提示
# ----------------------------------------------------------------------------
# 下列变量此前在源码/compose 中带有硬编码默认值，均为公开值，已全部移除默认值。
# 部署前必须逐项填入真实值，否则相关服务会启动失败（这是有意设计：宁可启动失败，
# 也不要带着公开密钥静默运行）。
#
# 上线前请务必轮换：KMS_TOKEN_SECRET、INTERNAL_TOKEN、MYSQL_ROOT_PASSWORD、
# DRUID_LOGIN_PASSWORD、FISCO_PRIVATE_KEY。
# 轮换 FISCO_PRIVATE_KEY 需要重新部署 KeyEvidence 合约，会与历史链上存证地址脱钩，
# 请确认历史存证可归档后再执行。
# ============================================================================

# ========== 中间件配置 ==========
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=kms

REDIS_HOST=redis
REDIS_PORT=6379

KAFKA_HOST=kafka
KAFKA_PORT=9092

FISCO_HOST=fisco-node
FISCO_PORT=8545
FISCO_CONTRACT_ADDRESS=
FISCO_PRIVATE_KEY=
KMS_CHAIN_RESULT_TOPIC=key_chain_result

# ========== 可选 Fabric 国密 DID 适配（缺真实链资料时不要开启/切换）==========
KMS_CHAIN_BACKEND=legacy
# 用户要求暂缓全部真实上链；恢复写入和启动历史链任务消费分别显式确认。
KMS_CHAIN_WRITES_ENABLED=false
KMS_CHAIN_CONSUMER_ENABLED=false
KMS_LIFECYCLE_CHAIN_SYNC_ENABLED=false
KMS_LIFECYCLE_CHAIN_CONSUMER_ENABLED=false
FABRIC_DID_ENABLED=false
FABRIC_DID_WRITE_ENABLED=false
FABRIC_DID_CREATE_POLICY_APPROVED=false
FABRIC_DID_CHAIN_ID=
FABRIC_DID_METHOD_ID=
FABRIC_DID_NAMESPACE=kms-key-binding-v1
FABRIC_DID_BRIDGE_URL=http://fabric-did-bridge:9094/internal/fabric-did
FABRIC_DID_MAX_METADATA_BYTES=65536
# 实际 connection/MSP/TLS/controller 文件放外置 fabric-did-secrets 只读挂载；
# 不把参考 IP、mspId、通道、链码或其他应用的 DID 当真实默认值。

# ========== 分发模块（PQKDS）adapter 服务凭据（**可选，当前无消费方**）==========
# 这两项只被 backend/pqkds/kms_adapter.py 读取，用于校验「KMS → 分发模块」方向的
# 服务调用（请求头 X-Kms-Service-Token / X-Kms-Service-Id）。
#
# 但目前**没有消费方**：
#   * 它守的 4 个接口（generate_key / update_lifecycle / revoke / distribute_key_pool）
#     没有挂进 backend/pqkds/urls.py —— urls.py import 的是 views.py 里的同名函数；
#   * 全仓库没有任何代码发送 X-Kms-Service-Token 头。
# 所以留空是有效状态（adapter 视为关闭），不影响任何功能。
# 若将来真的启用该 adapter，把 TOKEN 设成与调用方发送的一致（至少 32 位随机串），
# SERVICE_ID 可选（设置了就会一起校验）。
PQKDS_KMS_ADAPTER_SERVICE_TOKEN=
PQKDS_KMS_ADAPTER_SERVICE_ID=

# ========== 登录验证码开关（**所有登录页共用同一个值**）==========
# 取值：true = 登录需要图形验证码；false = 不需要。
#
# 为什么必须显式配置：此前只有 updatedel-java 读这个变量（compose 给了 `:-false`
# 的默认值），而用户前台的登录打在 generate-java 上、那个服务没有这个覆盖 ——
# 于是同一个系统里出现"管理端登录不要验证码、用户前台要验证码"，
# 看起来像登录页有两套并且坏了一套（2026-09-24 用户反馈）。
# 现在两个后端都读它，**一个开关决定所有登录页**。
#
# 开发/联调可以 false（tools/ 下的验收脚本依赖无验证码登录）；
# **对外提供服务前必须改成 true** —— 关掉验证码意味着登录接口可被无限次尝试。
KMS_CAPTCHA_ENABLED=false

# ========== 受控免登录演示（默认关闭，禁止公网/生产数据库）==========
# 本机显式开启：docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d
# 只有回环 8088 入口开放 Demo，原 80 入口不开放。INTERNAL_TOKEN 使用 URL-safe 随机串。
KMS_DEMO_ENABLED=false
KMS_DEMO_ALLOWED_HOSTS=127.0.0.1:8088,localhost:8088
KMS_DEMO_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
KMS_DEMO_COOKIE_SECURE=false

# ========== 必填安全凭据（无默认值）==========

# JWT 签名密钥。三个后端（generate / updatedel / distribute）必须使用同一值，
# 因为它们共用 Redis 与登录态以支持跨服务调用。
# 要求：长度不少于 32 字符的随机串。
# 生成示例：openssl rand -hex 32
KMS_TOKEN_SECRET=

# 服务间内部 Token。Java 业务层调用 Go 入站层时经 X-Internal-Token 传递。
# Go 侧缺失该项会直接 panic；Java 侧缺失会因占位符无法解析而启动失败。
# 生成示例：openssl rand -hex 24
INTERNAL_TOKEN=

# Druid 监控控制台口令（/druid/** 已不再匿名放行，但仍需设置强口令）。
DRUID_LOGIN_USERNAME=
DRUID_LOGIN_PASSWORD=

# ========== KGC 主私钥（**必填**，缺失或仍为演示值则拒绝启动）==========
# 无证书方案（SM2 / SSCL）里唯一的秘密。服务端只发布由它派生的公开参数，
# 而**任何拿到它的人都能为任意身份伪造部分私钥**，从而彻底架空无证书安全模型。
#
# 历史上这里留空，于是服务会静默回退到一个**硬编码在源码里的公开演示值**
# （6BDD93…A9FF9，见各 KgcMasterSecret/DemoKgcMasterSecret）。该值同时被一个
# 只读接口间接泄露，等于秘密公开。现已改为：
#   - 留空 / 仍是演示值 → 服务直接启动失败，不再静默降级；
#   - 部署时必须注入一把真实随机值。
#
# 生成示例（32 字节 → 64 位十六进制）：
#   openssl rand -hex 32
#
# ---------------------------------------------------------------------------
# 版本化（重要）：轮换不再一次性作废历史
# ---------------------------------------------------------------------------
# `ms` 是 PPub / SSCL 份额 / 链上公钥 P_A 的共同种子，一旦轮换，用旧 ms 算出的
# 历史 P_A 就再也复算不出来 —— 链上存证随之失去可验证性。
#
# 因此本系统把 ms 做成**带版本号的密钥集**：
#   * KGC_MASTER_SECRET       —— 当前**启用**的密钥（新记录一律用它）
#   * KGC_MASTER_SECRET_ID    —— 它的版本号，例如 ms_v2
#   * KGC_MASTER_SECRET_RETIRED —— 已退役但**仍需保留**的密钥，JSON 映射
#
# 每条密钥记录会写明自己是用哪个版本的 ms 生成的（`keymanage.ms_key_id`），
# 校验历史 P_A 时按记录里的版本去取密钥，因此**历史记录始终可复算**。
#
# 轮换步骤：
#   1. 把当前 KGC_MASTER_SECRET / _ID 追加进 KGC_MASTER_SECRET_RETIRED；
#   2. 给 KGC_MASTER_SECRET 换成新随机值，_ID 递增（ms_v3、ms_v4…）。
# 退役密钥**只用于历史复算**，绝不会用于签发新记录。
#
# 上面那条"轮换后必须重新登记存量密钥"的旧结论已被本机制取代：
# 现在轮换不再破坏历史验证能力。
KGC_MASTER_SECRET=

# 当前启用密钥的版本号。留空时按 "ms_v1" 处理（兼容早期只有一把密钥的部署）。
KGC_MASTER_SECRET_ID=

# 已退役的密钥集，JSON：{"ms_v1":"<64 位十六进制>", ...}
# 留空表示没有历史密钥。**不要**为了"清理"而删掉这里的条目 ——
# 删掉等于让对应的历史 P_A 永久失去可复算性。
KGC_MASTER_SECRET_RETIRED=

# ========== kms-generate Go 后端 ==========
GENERATE_GO_PORT=8081

# ========== kms-generate Java 后端 ==========
GENERATE_JAVA_PORT=9081

# ========== kms-updatedel Go 后端 ==========
UPDATEDEL_GO_PORT=8082

# ========== kms-updatedel Java 后端 ==========
UPDATEDEL_JAVA_PORT=9082
